<Window x:Class="PlcToHmi.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PLC 变量转威纶通 HMI 标签工具"
        Width="920"
        Height="740"
        MinWidth="760"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5FA"
        FontFamily="Microsoft YaHei UI"
        FontSize="14">

    <Window.Resources>
        <!-- 主要操作按钮样式 -->
        <Style TargetType="Button" x:Key="PrimaryButton">
            <Setter Property="Background" Value="#3498DB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="22,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect Color="#3498DB" Opacity="0.25" BlurRadius="6" Direction="270" ShadowDepth="2"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2980B9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#21618C"/>
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.98" ScaleY="0.98" CenterX="0.5" CenterY="0.5"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#BDC3C7"/>
                                <Setter Property="Foreground" Value="#7F8C8D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 次要功能按钮样式 -->
        <Style TargetType="Button" x:Key="SecondaryButton">
            <Setter Property="Background" Value="#ECF0F1"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#BDC3C7"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#D5DBDB"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                                <Setter Property="Cursor" Value="No"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 白色卡片容器样式 -->
        <Style TargetType="Border" x:Key="CardStyle">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000" Opacity="0.06" BlurRadius="16" ShadowDepth="3"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 现代化选项卡样式 -->
        <Style TargetType="TabItem">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border Name="tabBorder"
                                Background="Transparent"
                                BorderThickness="0,0,0,2"
                                BorderBrush="Transparent"
                                Margin="0,0,12,0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="tabBorder" Property="BorderBrush" Value="#3498DB"/>
                                <Setter Property="Foreground" Value="#2563EB"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#1E293B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 现代化表格列头样式 -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <!-- 表格行样式 -->
        <Style TargetType="DataGridRow">
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <!-- 顶部操作区：高度自适应内容 -->
            <RowDefinition Height="Auto"/>
            <!-- 底部日志区：占据窗口剩余所有垂直空间 -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶部操作卡片 -->
        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,16">
            <StackPanel>
                <!-- 标题与副标题 -->
                <TextBlock Text="PLC 变量转威纶通 HMI 标签工具"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="#2C3E50"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,6"/>
                <TextBlock Text="基于 CsvHelper 工业级标准解析 · 威纶通 EasyBuilder Pro 专用格式转换"
                           FontSize="13"
                           Foreground="#7F8C8D"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,12"/>

                <!-- 使用帮助折叠卡片 -->
                <Expander Header="📖 使用帮助与特性说明" IsExpanded="False" Margin="0,0,0,14" HorizontalAlignment="Center" Width="760">
                    <Border Background="#F9FAFB" CornerRadius="6" Padding="12" Margin="0,6,0,0">
                        <StackPanel>
                            <TextBlock Text="💡 操作流程：" FontWeight="SemiBold" Foreground="#2C3E50"/>
                            <TextBlock Text="1. 在下方选择对应的 PLC 品牌；" Margin="0,2,0,2" Foreground="#555"/>
                            <TextBlock Text="2. 拖拽 CSV 文件至虚线区域，或点击【选择文件开始转换】（支持单选或批量多选）；" Margin="0,0,0,2" Foreground="#555"/>
                            <TextBlock Text="3. 程序将在源文件同级目录输出符合威纶通规范的 CSV 文件；" Margin="0,0,0,4" Foreground="#555"/>
                            <TextBlock Text="✨ 增强特性：" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,4,0,0"/>
                            <TextBlock Text="• 智能编码与 BOM 探测：全面自适应 UTF-8 / GB18030 / GBK 等格式，拒绝乱码；" Foreground="#555"/>
                            <TextBlock Text="• 标签唯一性防冲突：多文件合并时若存在同名变量，自动加序号去重，避免导入报错；" Foreground="#555"/>
                            <TextBlock Text="• 32位双字空间重叠检测：若 D0 为双字且后续又定义了 D1，日志将提供温和预警；" Foreground="#555"/>
                            <TextBlock Text="• 标准威纶通类型映射：自动转换 BOOL→Bit、INT→16-bit Signed、REAL→32-bit Float 等。" Foreground="#555"/>
                        </StackPanel>
                    </Border>
                </Expander>

                <!-- PLC 品牌选择栏 -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,16">
                    <TextBlock Text="选择 PLC 品牌："
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#2C3E50"
                               VerticalAlignment="Center"/>
                    <ComboBox Name="cmbPlcBrand"
                              Width="260"
                              Margin="10,0,0,0"
                              FontSize="14"
                              VerticalContentAlignment="Center">
                        <ComboBoxItem Content="松下 (Panasonic FP/KW)" Tag="Panasonic" IsSelected="True"/>
                        <ComboBoxItem Content="三菱 (Mitsubishi FX/Q)" Tag="Mitsubishi"/>
                        <ComboBoxItem Content="西门子 (Siemens S7-200/1200)" Tag="Siemens"/>
                        <ComboBoxItem Content="汇川 (Inovance H3U/H5U)" Tag="Huichuan"/>
                        <ComboBoxItem Content="台达 (Delta DVP)" Tag="Delta"/>
                        <ComboBoxItem Content="基恩士 (Keyence KV)" Tag="Keyence"/>
                        <ComboBoxItem Content="信捷 (Xinjie XD/XC)" Tag="Xinjie"/>
                    </ComboBox>
                </StackPanel>

                <!-- 拖放区域边框（弹性高度，视觉统一） -->
                <Border Name="dropAreaBorder"
                        Background="#F8F9FA"
                        CornerRadius="8"
                        Padding="20,18"
                        BorderBrush="#CBD5E1"
                        BorderThickness="2"
                        AllowDrop="True"
                        Drop="Border_Drop"
                        DragEnter="Border_DragEnter"
                        DragLeave="Border_DragLeave">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="📁" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                        <TextBlock Text="拖拽一个或多个 CSV 文件到此区域，或点击下方按钮"
                                   FontSize="14"
                                   Foreground="#64748B"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,10"/>
                        <Button Name="btnProcess"
                                Content="选择文件开始转换"
                                Click="btnProcess_Click"
                                Style="{StaticResource PrimaryButton}"
                                HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- 进度条与状态通知（转换时动态显示） -->
                <StackPanel Name="progressContainer" Margin="0,10,0,0" Visibility="Collapsed">
                    <Grid Margin="0,0,0,4">
                        <TextBlock Name="lblProgressStatus" Text="准备转换..." FontSize="12" Foreground="#475569" HorizontalAlignment="Left"/>
                        <TextBlock Name="lblProgressPercent" Text="0%" FontSize="12" FontWeight="SemiBold" Foreground="#3498DB" HorizontalAlignment="Right"/>
                    </Grid>
                    <ProgressBar Name="progressBar" Height="6" Maximum="100" Value="0" Foreground="#3498DB" Background="#E2E8F0" BorderThickness="0"/>
                </StackPanel>

                <!-- 转换统计指标仪表盘 -->
                <Border Name="dashboardPanel" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,12,0,0">
                    <UniformGrid Columns="4">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="📁 源文件:" FontSize="13" Foreground="#64748B" VerticalAlignment="Center"/>
                            <TextBlock Name="statSourceFiles" Text="0" FontSize="14" FontWeight="Bold" Foreground="#1E293B" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="🏷️ 有效标签:" FontSize="13" Foreground="#64748B" VerticalAlignment="Center"/>
                            <TextBlock Name="statTotalRows" Text="0" FontSize="14" FontWeight="Bold" Foreground="#059669" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="🛡️ 消除重名:" FontSize="13" Foreground="#64748B" VerticalAlignment="Center"/>
                            <TextBlock Name="statDuplicates" Text="0" FontSize="14" FontWeight="Bold" Foreground="#D97706" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="⚠️ 诊断预警:" FontSize="13" Foreground="#64748B" VerticalAlignment="Center"/>
                            <TextBlock Name="statWarnings" Text="0" FontSize="14" FontWeight="Bold" Foreground="#DC2626" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </UniformGrid>
                </Border>

                <!-- 快捷输出动作栏（转换完成后激活） -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                    <Button Name="btnOpenFolder"
                            Content="📂 打开输出目录"
                            Style="{StaticResource SecondaryButton}"
                            Margin="0,0,12,0"
                            IsEnabled="False"
                            Click="btnOpenFolder_Click"/>
                    <Button Name="btnOpenFile"
                            Content="📄 查看生成文件"
                            Style="{StaticResource SecondaryButton}"
                            IsEnabled="False"
                            Click="btnOpenFile_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 底部数据卡片：支持选项卡切换查看日志与表格数据预览 -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}">
            <TabControl Name="bottomTabControl" Background="Transparent" BorderThickness="0">
                <!-- 选项卡 1：诊断日志 -->
                <TabItem Header="📋 转换与诊断日志">
                    <Grid Margin="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- 日志操作工具栏 -->
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <TextBlock Text="实时处理日志与格式校验反馈：" FontSize="13" Foreground="#64748B" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Name="btnCopyLog"
                                        Content="复制日志"
                                        Width="70"
                                        Height="28"
                                        Margin="0,0,8,0"
                                        Background="#E2E8F0"
                                        Foreground="#334155"
                                        BorderThickness="0"
                                        FontSize="12"
                                        Cursor="Hand"
                                        Click="btnCopyLog_Click"/>
                                <Button Name="btnClearLog"
                                        Content="清空"
                                        Width="60"
                                        Height="28"
                                        Background="#94A3B8"
                                        Foreground="White"
                                        BorderThickness="0"
                                        FontSize="12"
                                        Cursor="Hand"
                                        Click="btnClearLog_Click"/>
                            </StackPanel>
                        </Grid>

                        <!-- 滚动日志文本区 -->
                        <Border Grid.Row="1" Background="#F8FAFC" CornerRadius="8" Padding="10">
                            <TextBox Name="logText"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"
                                     FontFamily="Consolas"
                                     FontSize="12"
                                     Foreground="#1E293B"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     VerticalAlignment="Stretch"
                                     HorizontalAlignment="Stretch"/>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- 选项卡 2：数据预览表格 (前20条) -->
                <TabItem Name="tabPreview" Header="📊 标签预览 (前20条)">
                    <Grid Margin="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <TextBlock Name="lblPreviewTip" Text="转换生成的前 20 条威纶通 HMI 标签数据预览：" FontSize="13" Foreground="#64748B" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- 预览表格 -->
                        <Border Grid.Row="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                            <DataGrid Name="dgPreview"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      CanUserResizeRows="False"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="#E2E8F0"
                                      RowBackground="White"
                                      AlternatingRowBackground="#F8FAFC"
                                      HeadersVisibility="Column"
                                      BorderThickness="0"
                                      Background="Transparent"
                                      SelectionMode="Single">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="50">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                <Setter Property="Foreground" Value="#94A3B8"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="变量名称 (Name)" Binding="{Binding Name}" Width="190">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                <Setter Property="Foreground" Value="#1E293B"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="PLC 品牌 (Brand)" Binding="{Binding Brand}" Width="160"/>
                                    <DataGridTextColumn Header="起始符号 (Symbol)" Binding="{Binding Symbol}" Width="110">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontWeight" Value="Medium"/>
                                                <Setter Property="Foreground" Value="#2563EB"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="起始地址 (Address)" Binding="{Binding Address}" Width="120"/>
                                    <DataGridTextColumn Header="数据类型 (DataType)" Binding="{Binding DataType}" Width="*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#059669"/>
                                                <Setter Property="FontWeight" Value="Medium"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>
        </Border>
    </Grid>
</Window>
